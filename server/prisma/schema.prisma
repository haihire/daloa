generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model admin_users {
  id            BigInt   @id(map: "idx_16499_primary") @default(autoincrement())
  username      String   @unique(map: "idx_16499_username")
  password_hash String
  role          String   @default("guest")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model apm_page_visits {
  id           BigInt   @id(map: "idx_16508_primary") @default(autoincrement())
  path         String
  device_type  String   @default("unknown")
  user_agent   String
  referrer     String?
  visits       Int      @default(1)
  visit_day    DateTime @default(now()) @db.Date
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  country_code String   @default("UNKNOWN")
  os_name      String   @default("Unknown")
  browser_name String   @default("Unknown")

  @@unique([path, device_type, country_code, os_name, browser_name, visit_day], map: "uk_page_device_country_os_browser_day")
}

model apm_request_timings {
  id          BigInt   @id(map: "idx_16522_primary") @default(autoincrement())
  scope       String
  name        String
  path        String?
  method      String?
  status_code Int?
  duration_ms Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_16522_idx_created_at")
  @@index([scope, name], map: "idx_16522_idx_scope_name")
}

model apm_site_clicks {
  id          BigInt     @id(map: "idx_16530_primary") @default(autoincrement())
  device_type String     @default("unknown")
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  /// loa_sites.seq FK. 이름/URL/카테고리는 loa_sites가 유일한 원본이라 여기엔 스냅샷을
  /// 두지 않는다(정규화) — 표시할 땐 항상 loa_sites를 조인해서 최신값을 가져온다.
  /// 사이트가 삭제되면 SET NULL: 클릭 개수는 남지만 어떤 사이트였는지는 더는 알 수 없다.
  site_idx    BigInt?
  loa_sites   loa_sites? @relation(fields: [site_idx], references: [seq], onDelete: SetNull, map: "fk_apm_site_clicks_site_idx")

  @@index([created_at], map: "idx_16530_idx_created_at")
  @@index([site_idx], map: "idx_16530_idx_site_idx")
}

model apm_youtube_clicks {
  id            BigInt   @id(map: "idx_16546_primary") @default(autoincrement())
  video_id      String
  video_title   String   @default("")
  channel_title String   @default("")
  device_type   String   @default("unknown")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_16546_idx_created_at")
  @@index([video_id], map: "idx_16546_idx_video_id")
}

/// RUM(실사용자) 페이지 로딩 측정값. monitoring.repository.ts의 ensureMonitoringTables()가
/// 부팅 시 CREATE TABLE IF NOT EXISTS로 만든다 — 여기 모델은 DB와 동기화된 참고용이며,
/// 컬럼을 바꾸려면 이 파일이 아니라 db-migrations/에 ALTER를 추가할 것.
model apm_page_load_timings {
  id          BigInt   @id @default(autoincrement())
  source      String   @default("rum") @db.VarChar(16)
  path        String   @default("/") @db.VarChar(255)
  device_type String   @default("unknown") @db.VarChar(16)
  ttfb_ms     Int?
  dcl_ms      Int?
  lcp_ms      Int?
  load_ms     Int?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_apm_page_load_timings_created_at")
  @@index([source, created_at], map: "idx_apm_page_load_timings_source_created_at")
}

/// 서비스 변경(재시작/배포) 이벤트 로그. ensureMonitoringTables() 참고(위 주석과 동일).
model container_events {
  id          BigInt   @id @default(autoincrement())
  service     String   @db.VarChar(16)
  event_type  String   @db.VarChar(24)
  detail      String?  @db.VarChar(500)
  occurred_at DateTime @db.Timestamptz(6)
  detected_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([service, occurred_at], map: "idx_container_events_service_occurred_at")
}

/// 애플리케이션 에러 로그(AllExceptionsFilter가 기록). ensureMonitoringTables() 참고(위 주석과 동일).
model error_logs {
  id          BigInt   @id @default(autoincrement())
  status_code Int      @db.SmallInt
  error_name  String   @db.VarChar(80)
  method      String   @db.VarChar(10)
  path        String   @db.VarChar(512)
  message     String?
  stack       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_error_logs_created_at")
  @@index([status_code, created_at(sort: Desc)], map: "idx_error_logs_status_created_at")
}

/// 컨테이너별 CPU/메모리 샘플(nest/nginx/postgres/redis 4종, 5분 간격).
/// 4개 테이블이 컬럼 구조는 동일하고 이름만 다르다 — ensureMonitoringTables() 참고(위 주석과 동일).
model docker_metrics_nest {
  id           BigInt   @id @default(autoincrement())
  cpu_percent  Decimal  @db.Decimal(5, 2)
  mem_used_mb  Int
  mem_total_mb Int
  mem_percent  Decimal  @db.Decimal(5, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_docker_nest_created_at")
}

model docker_metrics_nginx {
  id           BigInt   @id @default(autoincrement())
  cpu_percent  Decimal  @db.Decimal(5, 2)
  mem_used_mb  Int
  mem_total_mb Int
  mem_percent  Decimal  @db.Decimal(5, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_docker_nginx_created_at")
}

model docker_metrics_postgres {
  id           BigInt   @id @default(autoincrement())
  cpu_percent  Decimal  @db.Decimal(5, 2)
  mem_used_mb  Int
  mem_total_mb Int
  mem_percent  Decimal  @db.Decimal(5, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_docker_postgres_created_at")
}

model docker_metrics_redis {
  id           BigInt   @id @default(autoincrement())
  cpu_percent  Decimal  @db.Decimal(5, 2)
  mem_used_mb  Int
  mem_total_mb Int
  mem_percent  Decimal  @db.Decimal(5, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_docker_redis_created_at")
}

/// 호스트 전체 자원의 5분 스냅샷(컨테이너 4종 + 도커 오버헤드 + OS 기타 + 호스트 총합).
/// ensureMonitoringTables() 참고(위 주석과 동일).
model host_resource_breakdown {
  id                          BigInt   @id @default(autoincrement())
  nest_cpu_percent            Decimal  @db.Decimal(5, 2)
  nest_mem_used_mb            Int
  nginx_cpu_percent           Decimal  @db.Decimal(5, 2)
  nginx_mem_used_mb           Int
  redis_cpu_percent           Decimal  @db.Decimal(5, 2)
  redis_mem_used_mb           Int
  postgres_cpu_percent        Decimal  @db.Decimal(5, 2)
  postgres_mem_used_mb        Int
  docker_overhead_cpu_percent Decimal  @db.Decimal(5, 2)
  docker_overhead_mem_mb      Int
  os_other_cpu_percent        Decimal  @db.Decimal(5, 2)
  os_other_mem_mb             Int
  host_cpu_percent            Decimal  @db.Decimal(5, 2)
  host_mem_used_mb            Int
  host_mem_total_mb           Int
  created_at                  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_host_resource_breakdown_created_at")
}

model loa_sites {
  seq             BigInt            @id(map: "idx_16576_primary") @default(autoincrement())
  name            String
  href            String            @unique(map: "idx_16576_uq_href")
  category        String?
  description     String?
  icon            String?
  is_active       Boolean?          @default(true)
  last_title      String?
  last_status     Int?
  checked_at      DateTime?         @db.Timestamptz(6)
  apm_site_clicks apm_site_clicks[]
}

model inven_posts {
  id         BigInt   @id @default(autoincrement())
  board      String // 'free' | 'tip'
  post_id    String   @unique
  url        String
  title      String
  author     String   @default("")
  date_str   String   @default("")
  views      Int      @default(0)
  likes      Int      @default(0)
  content    String?
  comments   Json     @default("[]")
  crawled_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([board, crawled_at])
  @@index([crawled_at])
}

model inven_site_candidates {
  id             BigInt   @id @default(autoincrement())
  url            String
  domain         String   @unique
  name           String   @default("")
  description    String   @default("")
  category       String   @default("")
  mention_count  Int      @default(1)
  sample_post_id String?
  status         String   @default("pending") // pending | added | rejected
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, mention_count(sort: Desc)])
}

model inven_site_blacklist {
  id         BigInt   @id @default(autoincrement())
  domain     String   @unique
  reason     String   @default("")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// 방문자가 남긴 익명 피드백. 작성자 식별 정보는 저장하지 않는다(익명 원칙).
model user_feedbacks {
  id          BigInt    @id @default(autoincrement())
  message     String
  path        String    @default("/")
  device_type String    @default("unknown")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  /// 작성자 브라우저가 스스로 센 방문 이력 요약. 0 = 기록 없음(기능 배포 이전)
  visit_days  Int       @default(0)
  visit_count Int       @default(0)
  first_seen_at DateTime? @db.Date

  @@index([created_at(sort: Desc)])
}

/// RAG 지식베이스 문서. append-only 스냅샷 — 생성 후 내용을 수정하지 않는다.
model rag_documents {
  id           BigInt     @id @default(autoincrement())
  title        String
  source       String
  period_start DateTime   @db.Date
  period_end   DateTime   @db.Date
  content_md   String
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  rag_chunks   rag_chunks[]

  @@index([source, period_start(sort: Desc)], map: "rag_documents_source_period_idx")
}

/// rag_documents를 청크 단위로 쪼개 임베딩한 벡터.
/// embedding은 Prisma가 vector 타입을 지원하지 않아 Unsupported — 읽기/쓰기는 $queryRaw로만.
model rag_chunks {
  id            BigInt        @id @default(autoincrement())
  document_id   BigInt
  chunk_index   Int
  content       String
  embedding     Unsupported("vector(1024)")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  rag_documents rag_documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, chunk_index])
}

/// 운영 챗봇 Q&A 로그. 벡터 컬럼이 없어 rag_documents/rag_chunks와 달리 Prisma Client로 바로 다룬다.
model rag_chat_logs {
  id              BigInt   @id @default(autoincrement())
  question        String
  answer          String
  model           String
  admin_username  String
  rag_chunk_count Int      @default(0)
  duration_ms     Int?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "rag_chat_logs_created_at_idx")
}
